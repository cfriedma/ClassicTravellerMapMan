{
  "name": "classic-traveller-map-man",
  "version": "1.0.0",
  "description": "A Classic Traveller Map Management application built with Angular",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:server": "ng build --configuration server",
    "build:electron": "ng build --configuration electron",
    "electron:start": "npm run build:electron && npm_config_force_build=1 electron-rebuild -f -w better-sqlite3 && electron .",
    "electron:dist": "npm run build:electron && npm_config_force_build=1 electron-builder",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "better-sqlite3": "^13.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@electron/rebuild": "^4.2.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.2.0"
  },
  "build": {
    "appId": "com.classictraveller.mapman",
    "productName": "Classic Traveller Map Man",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "dist/classic-traveller-map-man/**/*",
      "electron/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ]
  }
}
